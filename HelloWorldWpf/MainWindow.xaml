<Window x:Class="HelloWorldWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencia telefonátov"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FB">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#005A9E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6B7A" />

        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1A1A1A" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="#D2D9E3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentDarkBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#A5B9D0" />
                    <Setter Property="BorderBrush" Value="#A5B9D0" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#9FB3C8" />
            <Setter Property="Foreground" Value="#294766" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="24">
        <Border Background="{StaticResource PanelBrush}" Padding="18" Margin="0,0,0,18" DockPanel.Dock="Top" BorderBrush="#E1E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Evidencia telefonátov" FontSize="28" FontWeight="Bold" Foreground="#1F2937" />
                    <TextBlock Text="Moderný prehľad hovorov, poznámok a času vybavenia" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14" />
                </StackPanel>

                <Border Grid.Column="1" Background="#F8FAFD" BorderBrush="#DCE5EF" BorderThickness="1" Padding="10" CornerRadius="8">
                    <DockPanel>
                        <TextBlock Text="🔎" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="16" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Margin="0" Padding="0" VerticalContentAlignment="Center" ToolTip="Vyhľadávanie podľa mena, čísla, témy alebo poznámky" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="14" BorderBrush="#E1E8F0" BorderThickness="1" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Zoznam telefonátov" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,12" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CallsView}"
                              SelectedItem="{Binding SelectedCall}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#F8FAFD"
                              Background="White"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="58" IsReadOnly="True" />
                            <DataGridTextColumn Header="Volajúci" Binding="{Binding CallerName}" Width="170" IsReadOnly="True" />
                            <DataGridTextColumn Header="Telefón" Binding="{Binding PhoneNumber}" Width="145" IsReadOnly="True" />
                            <DataGridTextColumn Header="Téma" Binding="{Binding Topic}" Width="170" IsReadOnly="True" />
                            <DataGridTextColumn Header="Poznámka" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                            <DataGridTextColumn Header="Zaevidované" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="135" IsReadOnly="True" />
                            <DataGridTextColumn Header="Vybavené" Binding="{Binding CompletedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="135" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Stav" Binding="{Binding IsCompleted}" Width="80" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource PanelBrush}" Padding="16" BorderBrush="#E1E8F0" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Nový telefonát" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Meno volajúceho" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding NewCallerName, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Telefónne číslo" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Text="Téma hovoru" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding NewTopic, UpdateSourceTrigger=PropertyChanged}" />

                        <Button Content="Pridať telefonát" Command="{Binding AddCallCommand}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" Padding="16" BorderBrush="#E1E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Detail vybraného" Style="{StaticResource CardTitleStyle}" Margin="0,0,0,10" />

                        <TextBlock Text="Vybraný záznam:" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedCall.CallerName, TargetNullValue=Bez výberu}" FontWeight="SemiBold" Margin="0,2,0,10" />

                        <TextBlock Text="Poznámka:" Foreground="{StaticResource MutedBrush}" />
                        <TextBox Text="{Binding SelectedCall.Note, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />

                        <Button Content="Označiť ako vybavené" Command="{Binding MarkCompletedCommand}" />
                        <Button Content="Obnoviť vyhľadávanie" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ClearSearchCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>

<Window x:Class="HelloWorldWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Evidencia telefonátov"
        Height="720"
        Width="1200"
        MinHeight="620"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="OfficeBlue" Color="#0F6CBD" />
        <SolidColorBrush x:Key="OfficeBlueDark" Color="#0B5CAB" />
        <SolidColorBrush x:Key="OfficeSurface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="OfficeBg" Color="#F3F3F3" />
        <SolidColorBrush x:Key="OfficeBorder" Color="#D5D5D5" />
        <SolidColorBrush x:Key="OfficeText" Color="#1F1F1F" />
        <SolidColorBrush x:Key="OfficeSubtle" Color="#616161" />

        <Style TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OfficeText}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,4,0,10" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{StaticResource OfficeBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,8,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource OfficeBlue}" />
            <Setter Property="BorderBrush" Value="{StaticResource OfficeBlue}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource OfficeBlueDark}" />
                    <Setter Property="BorderBrush" Value="{StaticResource OfficeBlueDark}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD" />
                    <Setter Property="BorderBrush" Value="#BDBDBD" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#BEBEBE" />
            <Setter Property="Foreground" Value="#2D2D2D" />
        </Style>
    </Window.Resources>

    <DockPanel Background="{StaticResource OfficeBg}">
        <Border DockPanel.Dock="Top" Background="{StaticResource OfficeBlue}" Height="74" CornerRadius="0" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Evidencia telefonátov" FontSize="24" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Štýl inšpirovaný Microsoft Office 2024" Foreground="#DCEBFA" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="White" BorderBrush="#AFC8E4" BorderThickness="1" Padding="10,6" CornerRadius="4" VerticalAlignment="Center">
                    <DockPanel>
                        <TextBlock Text="🔎" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="14" />
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Margin="0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Vyhľadávanie podľa mena, čísla, témy alebo poznámky" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource OfficeSurface}" BorderBrush="{StaticResource OfficeBorder}" BorderThickness="1" Padding="12" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Zoznam telefonátov" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,10" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding CallsView}"
                              SelectedItem="{Binding SelectedCall}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              BorderThickness="0"
                              RowHeaderWidth="0"
                              AlternatingRowBackground="#FAFAFA"
                              Background="White"
                              FontSize="12.5"
                              ColumnHeaderHeight="33">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F5F5" />
                                <Setter Property="Foreground" Value="#202020" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderBrush" Value="#DDDDDD" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Padding" Value="8,6" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="55" IsReadOnly="True" />
                            <DataGridTextColumn Header="Volajúci" Binding="{Binding CallerName}" Width="165" IsReadOnly="True" />
                            <DataGridTextColumn Header="Telefón" Binding="{Binding PhoneNumber}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Téma" Binding="{Binding Topic}" Width="160" IsReadOnly="True" />
                            <DataGridTextColumn Header="Poznámka" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="220" />
                            <DataGridTextColumn Header="Zaevidované" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Vybavené" Binding="{Binding CompletedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130" IsReadOnly="True" />
                            <DataGridCheckBoxColumn Header="Stav" Binding="{Binding IsCompleted}" Width="76" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <Border Background="{StaticResource OfficeSurface}" BorderBrush="{StaticResource OfficeBorder}" BorderThickness="1" Padding="14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nový telefonát" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Meno volajúceho" Foreground="{StaticResource OfficeSubtle}" />
                        <TextBox Text="{Binding NewCallerName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Telefónne číslo" Foreground="{StaticResource OfficeSubtle}" />
                        <TextBox Text="{Binding NewPhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Téma hovoru" Foreground="{StaticResource OfficeSubtle}" />
                        <TextBox Text="{Binding NewTopic, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Pridať telefonát" Command="{Binding AddCallCommand}" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource OfficeSurface}" BorderBrush="{StaticResource OfficeBorder}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Detail vybraného" Style="{StaticResource TitleTextStyle}" Margin="0,0,0,8" />
                        <TextBlock Text="Vybraný záznam" Foreground="{StaticResource OfficeSubtle}" />
                        <TextBlock Text="{Binding SelectedCall.CallerName, TargetNullValue=Bez výberu}" FontWeight="SemiBold" Margin="0,2,0,10" />
                        <TextBlock Text="Poznámka" Foreground="{StaticResource OfficeSubtle}" />
                        <TextBox Text="{Binding SelectedCall.Note, UpdateSourceTrigger=PropertyChanged}" Height="84" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" />
                        <Button Content="Označiť ako vybavené" Command="{Binding MarkCompletedCommand}" />
                        <Button Content="Obnoviť vyhľadávanie" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=ClearSearchCommand}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
